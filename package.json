{
  "name": "marry-base",
  "version": "1.0.0",
  "private": true,
  "description": "MARRY BASE — Independent self-hostable backend, database, and mobile APK platform",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && npm run build:apk",
    "build:apk": "tsx src/cli/index.ts apk build",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "ws": "^8.18.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
