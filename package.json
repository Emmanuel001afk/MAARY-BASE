{
  "name": "mari-base",
  "version": "1.0.0",
  "private": true,
  "description": "MARI BASE — Self-hostable PostgreSQL backend development platform with Management Studio and Android companion",
  "type": "module",
  "bin": {
    "mari-base": "./dist/cli/index.js"
  },
  "exports": {
    ".": "./dist/app.js",
    "./sdk": "./dist/sdk/index.js",
    "./cli": "./dist/cli/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "check:studio": "node --check public/dashboard/app.js && node --check public/dashboard/js/core.js && node --check public/dashboard/js/pages.js && node --check public/dashboard/js/actions.js",
    "check:mobile": "node --check public/mobile/app.js && node --check public/mobile/config.js",
    "build": "npm run check:studio && npm run check:mobile && tsc -p tsconfig.json",
    "build:android": "tsx src/cli/index.ts apk build",
    "verify:apk": "node scripts/verify-apk.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "cli": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.15",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.2.0",
    "dotenv": "^16.6.1",
    "fastify": "^5.4.0",
    "pg": "^8.16.3",
    "ws": "^8.18.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.16.5",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
