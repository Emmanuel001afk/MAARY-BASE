NODE_ENV=development
HOST=0.0.0.0
PORT=4100
LOG_LEVEL=info
# External PostgreSQL (recommended for production / Docker Compose):
# DATABASE_URL=postgres://maary:change-me@localhost:5432/maary
# Embedded persistent PostgreSQL (zero-dependency local development):
DATABASE_URL=pglite://./data/postgres
DATABASE_POOL_MAX=20
STATEMENT_TIMEOUT_MS=15000
MAX_QUERY_ROWS=1000
CORS_ORIGIN=*
# Generate unique 32+ character secrets (e.g. openssl rand -hex 32) before production deployment.
JWT_SECRET=maary-base-dev-jwt-secret-change-in-production-0123456789
ENCRYPTION_KEY=maary-base-dev-encryption-master-key-change-in-prod-32b
PLATFORM_BOOTSTRAP_TOKEN=maary-base-dev-bootstrap-token-change-in-production-0123456789
TRUST_PROXY=false
STORAGE_BACKEND=local
STORAGE_DIR=./storage
BACKUP_DIR=./data/backups
MAX_UPLOAD_BYTES=52428800
FUNCTION_TIMEOUT_MS=5000
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
AUTO_MIGRATE=true
RATE_LIMIT_MAX=1000
# Optional path to a prebuilt Gradle Android APK artifact (defaults to ./releases/marry-base-android.apk)
# ANDROID_APK_PATH=./releases/marry-base-android.apk
