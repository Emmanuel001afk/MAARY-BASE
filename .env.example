NODE_ENV=development
HOST=0.0.0.0
PORT=4100
LOG_LEVEL=info
# Use URL-safe characters here or URL-encode the password in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
DATABASE_URL=postgres://maary:replace-with-a-strong-url-safe-password@localhost:5432/maary
# Generate a unique secret with: openssl rand -hex 32
TOKEN_SECRET=replace-this-with-at-least-32-random-characters
CORS_ORIGIN=http://localhost:3000
