NODE_ENV=development
HOST=0.0.0.0
PORT=4100
LOG_LEVEL=info
# External PostgreSQL (e.g. Docker Compose): postgres://maary:change-me@localhost:5432/maary
# Or embedded persistent PostgreSQL: pglite://./data/postgres
DATABASE_URL=pglite://./data/postgres
DATABASE_POOL_MAX=20
STATEMENT_TIMEOUT_MS=15000
MAX_QUERY_ROWS=1000
CORS_ORIGIN=*
# Generate fresh, unique values before production deployment.
JWT_SECRET=maary-base-dev-jwt-secret-change-in-production-0123456789
ENCRYPTION_KEY=maary-base-dev-encryption-master-key-change-in-prod-32b
PLATFORM_BOOTSTRAP_TOKEN=maary-base-dev-bootstrap-token-change-in-production-0123456789
TRUST_PROXY=false
# Reused across builds so Android accepts future APKs as upgrades. Back up this
# private key securely; alternatively provide APK_SIGNING_PRIVATE_KEY as a secret.
APK_SIGNING_KEY_FILE=./data/apk-signing/private-key.pem
STORAGE_BACKEND=local
STORAGE_DIR=./storage
BACKUP_DIR=./data/backups
MAX_UPLOAD_BYTES=52428800
FUNCTION_TIMEOUT_MS=5000
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
AUTO_MIGRATE=true
RATE_LIMIT_MAX=600
