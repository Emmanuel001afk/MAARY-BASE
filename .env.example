NODE_ENV=development
HOST=0.0.0.0
PORT=4100
LOG_LEVEL=info
# External PostgreSQL (e.g. Docker Compose): postgres://maary:change-me@localhost:5432/maary
# Or embedded persistent PostgreSQL: pglite://./data/postgres
DATABASE_URL=pglite://./data/postgres
DATABASE_POOL_MAX=20
STATEMENT_TIMEOUT_MS=15000
MAX_QUERY_ROWS=1000
CORS_ORIGIN=*
JWT_SECRET=change-this-jwt-secret-to-at-least-32-random-bytes
ENCRYPTION_KEY=change-this-encryption-key-to-at-least-32-random-bytes
STORAGE_BACKEND=local
STORAGE_DIR=./storage
BACKUP_DIR=./data/backups
MAX_UPLOAD_BYTES=52428800
FUNCTION_TIMEOUT_MS=5000
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
AUTO_MIGRATE=true
RATE_LIMIT_MAX=600
