NODE_ENV=development
HOST=0.0.0.0
PORT=4100
LOG_LEVEL=info
# External PostgreSQL (e.g. Docker Compose): postgres://maary:change-me@localhost:5432/maary
# Or embedded persistent PostgreSQL: pglite://./data/postgres
DATABASE_URL=pglite://./data/postgres
DATABASE_POOL_MAX=20
STATEMENT_TIMEOUT_MS=15000
MAX_QUERY_ROWS=1000
CORS_ORIGIN=*
# Generate fresh, unique values before production deployment.
JWT_SECRET=maary-base-dev-jwt-secret-change-in-production-0123456789
ENCRYPTION_KEY=maary-base-dev-encryption-master-key-change-in-prod-32b
PLATFORM_BOOTSTRAP_TOKEN=maary-base-dev-bootstrap-token-change-in-production-0123456789
TRUST_PROXY=false
# Android companion artifact. MARRY BASE never fabricates APKs: this path must
# contain a package produced by `npm run android:build` (Gradle) or copied from
# the CI workflow artifact. Missing/invalid artifacts are reported as such.
APK_ARTIFACT_PATH=releases/marry-base.apk
APK_METADATA_PATH=releases/marry-base.apk.json
ANDROID_PROJECT_DIR=android
APP_VERSION=1.1.0
# APP_COMMIT is optional; CI sets it for deployment diagnostics.
# Java binary used for Gradle builds (JDK 17+ required) and ANDROID_HOME must be set.
JAVA_BIN=java
STORAGE_BACKEND=local
STORAGE_DIR=./storage
BACKUP_DIR=./data/backups
MAX_UPLOAD_BYTES=52428800
FUNCTION_TIMEOUT_MS=5000
WORKER_ENABLED=true
WORKER_POLL_INTERVAL_MS=1000
AUTO_MIGRATE=true
RATE_LIMIT_MAX=600
# Optional S3-compatible object storage (set STORAGE_BACKEND=s3 to use it).
# STORAGE_BACKEND=s3
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=maary-objects
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
